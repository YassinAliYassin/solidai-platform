# Shared bearer token required on POST /api/chat/query.
# Send it as: Authorization: Bearer <value>
# The route returns 503 when this is unset and 401 when the token is missing or wrong.
# The MCP server (packages/cloud/mcp_server.py, tool solid_cloud_chat) reads this
# same variable from its own environment and sends it as a Bearer token.
# If it is unset or blank there, the tool raises before the HTTP call.
CLOUD_API_TOKEN=

# Provider key used by the chat route. Server-side only; never send it to the browser.
OPENROUTER_API_KEY=

# Comma-separated browser origins allowed to call this API (scheme + host + port).
# Leave empty to refuse cross-origin browser calls. A lone "*" is ignored.
# Local cloud frontend: http://localhost:5173
# Credentialed CORS is not enabled; the chat route uses the bearer token above.
CORS_ALLOW_ORIGINS=
