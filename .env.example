# --- Website assistant (Solid LLM chat) ---------------------------------
# The chat widget calls a same-origin serverless endpoint (api/chat.ts on
# Vercel, public/api/chat.php on cPanel) that holds the provider key
# server-side. Set this in your host's environment settings, NOT in the client.
#
# OPENROUTER_API_KEY: required for the assistant to answer. Get one at
#   https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."

# SOLID_LLM_MODEL: optional. Which OpenRouter model the assistant uses.
# Defaults to meta-llama/llama-3.3-70b-instruct if unset.
# SOLID_LLM_MODEL="meta-llama/llama-3.3-70b-instruct"

# VITE_CHAT_ENDPOINT: optional, build-time. Path the frontend posts to.
# Defaults to "/api/chat". Set to "/api/chat.php" for the cPanel/PHP deploy.
# VITE_CHAT_ENDPOINT="/api/chat"

# VITE_SOLID_LLM_API: optional, build-time. Base URL of the from-scratch model's
# FastAPI server (packages/llm) for the live demo on the /solid-llm page.
# e.g. "https://api.solidsolutions.africa". Leave unset to hide the live demo.
# VITE_SOLID_LLM_API="https://api.solidsolutions.africa"

# --- Legacy (AI Studio) --------------------------------------------------
# GEMINI_API_KEY: only used if you wire up Gemini calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: hosting URL for self-referential links.
APP_URL="MY_APP_URL"
